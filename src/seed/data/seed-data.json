    "roles": [
        {
            "name": "Super Admin",
            "description": "System Administrator with full access",
            "permissions": ["utilities:access", "utilities:roles", "utilities:users", "utilities:products", "utilities:categories", "utilities:payment_methods", "utilities:restaurants", "utilities:terminals", "tables:view", "tables:manage", "sales:manage", "sales:manage_active_payments", "sales:view_history", "kitchen:view", "kitchen:edit"],
            "defaultRoute": "/utilities"
        },
        {
            "name": "Admin",
            "description": "Administrator with managed access",
            "permissions": ["utilities:access", "utilities:roles", "utilities:users", "utilities:products", "utilities:payment_methods", "utilities:categories", "utilities:restaurants", "utilities:terminals", "tables:manage", "sales:view_history", "kitchen:view", "kitchen:edit", "sales:manage"],
            "defaultRoute": "/utilities"
        },
        {
            "name": "Manager",
            "description": "Has all permissions of Waiter, Cashier, and Chef.",
            "permissions": ["tables:manage", "sales:manage", "kitchen:view", "kitchen:edit", "sales:view_history"],
            "defaultRoute": "/sales"
        },
        {
            "name": "Cashier",
            "description": "Can process any payment (digital/cash). Cannot modify existing orders without Waiter/Manager confirmation.",
            "permissions": ["sales:manage_active_payments", "sales:view_history", "tables:view"],
            "defaultRoute": "/sales"
        },
        {
            "name": "Waiter",
            "description": "Takes and modifies orders, adds products. Can process digital payments only (no cash).",
            "permissions": ["sales:manage", "tables:view"],
            "defaultRoute": "/sales"
        },
        {
            "name": "Chef",
            "description": "Views orders and updates status: Commanded -> In Progress -> Ready.",
            "permissions": ["kitchen:view", "kitchen:edit"],
            "defaultRoute": "/kitchen"
        },
        {
            "name": "Cook",
            "description": "Read-only access to Kitchen display screens.",
            "permissions": ["kitchen:view"],
            "defaultRoute": "/kitchen"
        },
        {
            "name": "Guest",
            "description": "Default role for new users",
            "permissions": ["guest:view"],
            "defaultRoute": "/guest"
        }
    ],
